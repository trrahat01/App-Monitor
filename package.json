{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"try{const fs=require('fs');['package-lock.json','yarn.lock'].forEach(f=>{try{fs.rmSync(f,{force:true})}catch(e){}});const ua=process.env.npm_config_user_agent||'';if(!/pnpm\\//.test(ua)){console.error('Use pnpm instead');process.exit(1)}}catch(e){}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
